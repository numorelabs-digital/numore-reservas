# Supabase — https://app.supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...   # SOLO server-side (worker de notificaciones)

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (notificaciones gratis a la PWA). Generá las claves con: npm run gen:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@gmail.com

# Protege el endpoint del cron de notificaciones (Vercel lo envía automáticamente)
CRON_SECRET=
